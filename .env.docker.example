# ===================== JOBNEST — DOCKER ENVIRONMENT =====================
# Sao chép file này thành .env ở THƯ MỤC GỐC (cùng cấp docker-compose.yml),
# sau đó điền giá trị thật cho máy của bạn.
#
#   copy .env.docker.example .env
#
# File .env đã được .gitignore loại trừ — KHÔNG commit giá trị thật.

# ---- PostgreSQL ----
POSTGRES_USER=postgres
# Mật khẩu PostgreSQL cho container. Bắt buộc, compose sẽ báo lỗi nếu để trống.
POSTGRES_PASSWORD=
# Tên database MỚI dành riêng cho môi trường này (không dùng lại DB cũ).
POSTGRES_DB=cd2_marketplace_db

# ---- JWT ----
# Bắt buộc tối thiểu 32 ký tự.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Origin của frontend. Mặc định khớp với frontend container expose ở port 8080.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
