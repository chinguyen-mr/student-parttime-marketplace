# ===================== JOBNEST BACKEND — .env.example =====================
# Sao chép file này thành 03_backend/.env và điền giá trị thật của MÁY NÀY.
# KHÔNG commit file .env thật. KHÔNG ghi secret thật vào file .env.example này.

# ---- Server ----
PORT=5000
# HOST=127.0.0.1 cho triển khai cùng máy (Model A/B).
# HOST=0.0.0.0 khi cần cho máy khác trong LAN truy cập (Model C).
HOST=127.0.0.1
NODE_ENV=development

# ---- CORS ----
# Danh sách origin được phép, phân tách bằng dấu phẩy. Không dùng wildcard '*'.
# Model C: thêm origin của frontend máy khác, ví dụ http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=cd2_marketplace_db

# ---- JWT ----
# Bắt buộc tối thiểu 32 ký tự. Backend fail-fast nếu thiếu/ngắn.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_EXPIRES_IN=7d

# ---- Bootstrap ----
# off   = chỉ kiểm tra kết nối DB khi khởi động (mặc định, không ghi dữ liệu)
# check = kiểm tra + báo cáo thiếu bảng/dữ liệu và in lệnh thủ công cần chạy
# (Không có chế độ tự tạo DB/migration/seed. Chạy thủ công: npm run migrate / npm run seed)
AUTO_BOOTSTRAP=off

# ---- Seed tài khoản test (chỉ dùng khi chạy script setup thủ công) ----
# Không cần khi chạy backend. Không ghi mật khẩu thật vào file example.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EMPLOYER_PASSWORD=
SEED_STUDENT_PASSWORD=
