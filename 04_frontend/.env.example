# ===================== JOBNEST FRONTEND — .env.example =====================
# Sao chép file này thành 04_frontend/.env và điền giá trị phù hợp với máy chạy.
# KHÔNG commit .env thật. KHÔNG ghi secret hoặc thông tin cá nhân vào đây.

# URL gốc của API backend (luôn là URL tuyệt đối, không dùng URL tương đối).
#
# Model B — Frontend + Backend + PostgreSQL cùng một máy (mặc định):
VITE_API_URL=http://localhost:5000/api
#
# Model C — Frontend chạy trên máy khác với Backend:
# Đổi thành IP LAN/public của máy chạy Backend, ví dụ:
# VITE_API_URL=http://192.168.1.50:5000/api
