# ==============================================================================
# TWENTY CRM — ENVIRONMENT CONFIGURATION TEMPLATE FOR JOBNEST
# Copy this file to .env before starting Twenty CRM:
# cp .env.example .env
# ==============================================================================

# 1. Version Tag
TAG=latest

# 2. Network & Public URLs
# Host port mapping: 3020 on host maps to internal 3000
PORT=3020
SERVER_URL=http://localhost:3020

# 3. Security & Cryptographic Keys
# Generate a secure 32-character key using: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_a_secure_random_32_char_base64_string

# 4. Dedicated Database Credentials (SEPARATE from JobNest cd2_marketplace_db)
# Note: Avoid special characters like / : @ inside password to prevent URL parsing bugs
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=change_this_to_a_secure_password_123
PG_DATABASE_NAME=twenty

# 5. Access Control
# Set to true once the first admin account has been created
DISABLE_SIGN_UP=false

# 6. JobNest Integration Secret (For incoming webhooks from JobNest)
JOBNEST_SYNC_API_KEY=replace_with_shared_secret_between_jobnest_and_twenty

