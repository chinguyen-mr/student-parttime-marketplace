{
  "name": "chuyen-de-tot-nghiep-2-marketplace",
  "version": "1.0.0",
  "description": "Nền tảng quản lý freelance / marketplace việc làm part-time cho sinh viên (Chuyên đề tốt nghiệp 2 - Khoa CNTT - Đại học Văn Lang)",
  "scripts": {
    "setup": "npm run install:all && npm run connect:db",
    "connect:db": "node connect_db.js",
    "setup:db": "node connect_db.js",
    "install:all": "npm --prefix 03_backend install && npm --prefix 04_frontend install",
    "dev": "npm --prefix 04_frontend run dev",
    "dev:frontend": "npm --prefix 04_frontend run dev",
    "dev:backend": "npm --prefix 03_backend run dev",
    "dev:server": "npm --prefix 03_backend run dev",
    "frontend": "npm --prefix 04_frontend run dev",
    "backend": "npm --prefix 03_backend run dev",
    "server": "npm --prefix 03_backend run dev",
    "client": "npm --prefix 04_frontend run dev",
    "test": "npm --prefix 03_backend test",
    "migrate": "npm --prefix 03_backend run migrate",
    "seed": "npm --prefix 03_backend run seed",
    "build:frontend": "npm --prefix 04_frontend run build",
    "build": "npm --prefix 04_frontend run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  },
