{
  "version": 2,
  "buildCommand": "npm --prefix 04_frontend install && npm --prefix 04_frontend run build",
  "outputDirectory": "04_frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

